@@ -0,0 +1,18 @@
+import { expect, it, vi } from 'vitest';
+import { loadArtifactPreviews } from '../src/artifact-previews';
+
+it('keeps other results visible when one preview fails and allows that preview to be retried', async () => {
+  const read = vi.fn(async (id: string) => {
+    if (id === 'missing') throw new Error('HTTP 404');
+    return id === 'empty' ? '' : '协作结果';
+  });
+  const first = await loadArtifactPreviews(['missing', 'result', 'empty', 'result'], read);
+
+  expect(first.content).toEqual({ result: '协作结果', empty: '' });
+  expect(first.errors).toEqual({ missing: 'HTTP 404' });
+  expect(read).toHaveBeenCalledTimes(3);
+
+  const retried = await loadArtifactPreviews(['missing'], async () => '已恢复的结果');
+  expect(retried.content).toEqual({ missing: '已恢复的结果' });
+  expect(retried.errors).toEqual({});
+});
