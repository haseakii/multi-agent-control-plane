new file mode 100644
--- /dev/null
+++ b/integrations/hermes-workbench/src/artifact-previews.ts
@@ -0,0 +1,17 @@
+/** Preview failures belong to individual artifacts, not the engine connection state. */
+export async function loadArtifactPreviews(
+  ids: readonly string[],
+  read: (id: string) => Promise<string>,
+): Promise<{ content: Record<string, string>; errors: Record<string, string> }> {
+  const unique = [...new Set(ids)];
+  const results = await Promise.allSettled(unique.map(async (id) => read(id)));
+  const content: Record<string, string> = {};
+  const errors: Record<string, string> = {};
+  for (const [index, result] of results.entries()) {
+    const id = unique[index]!;
+    if (result.status === 'fulfilled') content[id] = result.value;
+    else
+      errors[id] = result.reason instanceof Error ? result.reason.message : '结果预览读取失败。';
+  }
+  return { content, errors };
+}
