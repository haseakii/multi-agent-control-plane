+import fs from 'node:fs';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+const uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
+const phases = new Set(['starting', 'ready', 'stopping']);
+const stopped = Symbol('instance-stop-requested');
+
+function processExists(pid) {
+  try {
+    process.kill(pid, 0); // Existence check only; never sends a termination signal.
+    return true;
+  } catch (error) {
+    if (error.code === 'ESRCH') return false;
+    throw new Error('Cannot establish whether the recorded instance exited; refusing takeover.');
+  }
+}
+
+/** Shared entry lifecycle; callers supply the existing data-lock implementation.
+ * Resource cleanup is registered immediately after construction, in acquisition order.
+ */
+export async function runWorkbenchInstance(
+  { run, data, url, acquireLock, previousProcessExists = processExists },
+  boot,
+) {
+  const port = Number(/^http:\/\/127\.0\.0\.1:(\d+)$/.exec(url)?.[1]);
+  if (!path.isAbsolute(run) || !path.isAbsolute(data) || !Number.isInteger(port) ||
+      port < 1 || port > 65535)
+    throw new Error('Invalid local instance paths or URL.');
+  const release = acquireLock(data);
+  const cleanup = [];
+  const info = path.join(run, 'server.json');
+  let metadata;
+  let timer;
+  let stopping = false;
+  let finish;
+  const stopRequested = new Promise((resolve) => { finish = resolve; });
+  const requestStop = () => { stopping = true; finish(); };
+  const publish = (value) => {
+    const temporary = path.join(run, `server-${value.instanceId}-${randomUUID()}.tmp`);
+    fs.writeFileSync(temporary, JSON.stringify(value, null, 2), { flag: 'wx' });
+    fs.renameSync(temporary, info);
+  };
+  const checkStop = () => {
+    if (!metadata || stopping) return stopping;
+    try {
+      const value = fs.readFileSync(path.join(run, `stop-${metadata.instanceId}`), 'utf8');
+      if (value.trim() === metadata.instanceId) requestStop();
+    } catch (error) {
+      if (error.code !== 'ENOENT') {
+        console.error('Cannot read this instance stop request; stopping conservatively.');
+        requestStop();
+      }
+    }
+    return stopping;
+  };
+  const assertRunning = () => { if (checkStop()) throw stopped; };
+  try {
+    // New peers are excluded by the data lock. Older unlocked entry points are
+    // not peers: refuse their still-live (or uncertain) process before opening SQLite.
+    if (fs.existsSync(info)) {
+      const known = JSON.parse(fs.readFileSync(info, 'utf8'));
+      if (!Number.isSafeInteger(known.pid) || known.pid <= 0 ||
+          typeof known.startedAt !== 'string' || !Number.isFinite(Date.parse(known.startedAt)) ||
+          typeof known.url !== 'string' || !/^http:\/\/127\.0\.0\.1:\d+$/.test(known.url) ||
+          (known.instanceId !== undefined && (!uuid.test(known.instanceId) || !phases.has(known.phase))))
+        throw new Error('Invalid prior instance metadata; retained without takeover.');
+      if (previousProcessExists(known.pid))
+        throw new Error('Recorded instance may still be running. Confirm its exit before starting this version.');
+    }
+    if (fs.existsSync(path.join(run, 'stop')))
+      console.warn('Legacy unscoped stop marker retained; this generation only accepts its own stop token.');
+    metadata = {
+      url, pid: process.pid, instanceId: randomUUID(),
+      startedAt: new Date().toISOString(), phase: 'starting',
+    };
+    publish(metadata); // Starting identity exists before any database open or await in boot.
+    process.on('SIGINT', requestStop);
+    process.on('SIGTERM', requestStop);
+    timer = setInterval(checkStop, 300);
+    await boot({
+      assertRunning,
+      get stopping() { return checkStop(); },
+      defer(close) {
+        if (typeof close !== 'function') throw new Error('Invalid resource cleanup.');
+        cleanup.push(close);
+      },
+      acquireResource(open, close) {
+        let resource;
+        let acquired = false;
+        let failure;
+        cleanup.push(async () => {
+          if (!acquired)
+            throw new Error('Resource initialization incomplete; data lock retained.', { cause: failure });
+          await close(resource);
+        });
+        try {
+          resource = open();
+          acquired = true;
+          return resource;
+        } catch (error) {
+          failure = error;
+          throw error;
+        }
+      },
+      ready(extra = {}) {
+        assertRunning();
+        metadata = { ...extra, ...metadata, phase: 'ready' };
+        publish(metadata);
+        // A request arriving during rename remains in its generation-specific file.
+        assertRunning();
+      },
+    });
+    await stopRequested;
+  } catch (error) {
+    if (error !== stopped) throw error;
+  } finally {
+    clearInterval(timer);
+    process.off('SIGINT', requestStop);
+    process.off('SIGTERM', requestStop);
+    if (metadata) {
+      try { publish({ ...metadata, phase: 'stopping' }); }
+      catch (error) { console.error('Stopping metadata was not saved:', error.message); }
+    }
+    try {
+      // HTTP drain precedes runtime/storage cleanup. A failed drain/cleanup must
+      // retain ownership, never close SQLite beneath a still-running handler.
+      for (const close of cleanup.reverse()) await close();
+    } catch (error) {
+      console.error('Instance cleanup incomplete; data lock retained.');
+      throw error;
+    }
+    release();
+  }
+}
diff --git a/integrations/hermes-workbench/tests/instance-lifecycle.test.mjs b/integrations/hermes-workbench/tests/instance-lifecycle.test.mjs
new file mode 100644
--- /dev/null
+++ b/integrations/hermes-workbench/tests/instance-lifecycle.test.mjs
@@ -0,0 +1,144 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { tmpdir } from 'node:os';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { runWorkbenchInstance } from '../instance-lifecycle.mjs';
+
+const roots = [];
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  for (const root of roots.splice(0)) {
+    if (!root.startsWith(path.resolve(tmpdir()) + path.sep)) throw Error('Unsafe fixture cleanup.');
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+function fixture() {
+  const run = fs.mkdtempSync(path.join(tmpdir(), 'hermes-lifecycle-'));
+  roots.push(run);
+  let locked = false;
+  const release = vi.fn(() => { locked = false; });
+  const acquireLock = vi.fn(() => {
+    if (locked) throw Error('Data directory is locked');
+    locked = true;
+    return release;
+  });
+  const options = {
+    run, data: path.join(run, 'data'), url: 'http://127.0.0.1:8047', acquireLock,
+    previousProcessExists: () => false,
+  };
+  const info = () => JSON.parse(fs.readFileSync(path.join(run, 'server.json'), 'utf8'));
+  const stop = (id = info().instanceId) => fs.writeFileSync(path.join(run, `stop-${id}`), id);
+  return { options, info, stop, release, locked: () => locked };
+}
+function deferred() {
+  let resolve;
+  const promise = new Promise((yes) => { resolve = yes; });
+  return { promise, resolve };
+}
+
+it('excludes a second boot before storage setup and retains ownership through complete HTTP drain', async () => {
+  const f = fixture(), entered = deferred(), drain = deferred(), order = [];
+  const running = runWorkbenchInstance(f.options, async (host) => {
+    expect(f.locked()).toBe(true);
+    host.defer(() => { order.push('storage'); });
+    host.defer(() => { order.push('runtime'); });
+    host.defer(async () => { order.push('http'); await drain.promise; });
+    host.ready();
+    entered.resolve();
+  });
+  await entered.promise;
+  const secondBoot = vi.fn();
+  await expect(runWorkbenchInstance(f.options, secondBoot)).rejects.toThrow('locked');
+  expect(secondBoot).not.toHaveBeenCalled();
+  f.stop();
+  await vi.advanceTimersByTimeAsync(300);
+  expect(order).toEqual(['http']);
+  expect(f.locked()).toBe(true);
+  drain.resolve();
+  await running;
+  expect(order).toEqual(['http', 'runtime', 'storage']);
+  expect(f.release).toHaveBeenCalledTimes(1);
+});
+
+it('retains ownership and storage if HTTP cleanup cannot be confirmed', async () => {
+  const f = fixture(), storageClose = vi.fn();
+  const running = runWorkbenchInstance(f.options, async (host) => {
+    host.defer(storageClose);
+    host.defer(async () => { throw Error('HTTP drain incomplete'); });
+    f.stop();
+    host.ready();
+  });
+  await expect(running).rejects.toThrow('HTTP drain incomplete');
+  expect(storageClose).not.toHaveBeenCalled();
+  expect(f.release).not.toHaveBeenCalled();
+});
+
+it('retains ownership if a resource constructor fails before returning its close handle', async () => {
+  const f = fixture(), close = vi.fn();
+  const running = runWorkbenchInstance(f.options, async (host) => {
+    host.acquireResource(() => { throw Error('migration failed'); }, close);
+  });
+  await expect(running).rejects.toThrow('Resource initialization incomplete');
+  expect(close).not.toHaveBeenCalled();
+  expect(f.release).not.toHaveBeenCalled();
+});
+
+it('honors a stop submitted to the starting generation without publishing ready', async () => {
+  const f = fixture();
+  let afterReady = false;
+  await runWorkbenchInstance(f.options, async (host) => {
+    expect(f.info().phase).toBe('starting');
+    f.stop();
+    host.ready();
+    afterReady = true;
+  });
+  expect(afterReady).toBe(false);
+  expect(f.info().phase).toBe('stopping');
+  expect(fs.existsSync(path.join(f.options.run, `stop-${f.info().instanceId}`))).toBe(true);
+  expect(f.release).toHaveBeenCalledTimes(1);
+});
+
+it('retains a stop arriving during ready publication instead of deleting it', async () => {
+  const f = fixture(), rename = fs.renameSync;
+  vi.spyOn(fs, 'renameSync').mockImplementation((from, to) => {
+    rename(from, to);
+    if (f.info().phase === 'ready') f.stop();
+  });
+  await runWorkbenchInstance(f.options, async (host) => host.ready());
+  expect(f.info().phase).toBe('stopping');
+  expect(fs.existsSync(path.join(f.options.run, `stop-${f.info().instanceId}`))).toBe(true);
+  expect(f.release).toHaveBeenCalledTimes(1);
+});
+
+it('ignores retained legacy and prior-generation stop markers without deleting them', async () => {
+  const f = fixture(), entered = deferred();
+  const previous = '11111111-1111-4111-8111-111111111111';
+  fs.writeFileSync(path.join(f.options.run, 'stop'), 'stop');
+  f.stop(previous);
+  const running = runWorkbenchInstance(f.options, async (host) => {
+    host.ready();
+    entered.resolve();
+  });
+  await entered.promise;
+  await vi.advanceTimersByTimeAsync(300);
+  expect(f.info().phase).toBe('ready');
+  expect(f.locked()).toBe(true);
+  f.stop();
+  await vi.advanceTimersByTimeAsync(300);
+  await running;
+  expect(fs.readFileSync(path.join(f.options.run, 'stop'), 'utf8')).toBe('stop');
+  expect(fs.existsSync(path.join(f.options.run, `stop-${previous}`))).toBe(true);
+});
+
+it('refuses a still-live legacy record before entering database setup', async () => {
+  const f = fixture(), boot = vi.fn();
+  fs.writeFileSync(path.join(f.options.run, 'server.json'), JSON.stringify({
+    pid: 12345, url: f.options.url, startedAt: new Date().toISOString(),
+  }));
+  await expect(runWorkbenchInstance({ ...f.options, previousProcessExists: () => true }, boot))
+    .rejects.toThrow('may still be running');
+  expect(boot).not.toHaveBeenCalled();
+  expect(f.release).toHaveBeenCalledTimes(1);
+});
